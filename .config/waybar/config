{
    "position": "top",
    "spacing": 16,
    "layer": "top",
    "output": ["eDP-1", "DP-1"],
    "modules-left": ["hyprland/workspaces", "network", "pulseaudio"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "wlr/taskbar", "custom/lofi", "custom/notification", "custom/power"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "persistent-workspaces": { "*": 2 },
        "all-outputs": false,
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "7": "七",
            "8": "八",
            "9": "九",
            "10": "十",
            "urgent": "",
            "focused": ""
        }
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": " ",
        "format-icons": ["", "", " "],
        "on-click": "pavucontrol",
        "on-right-click": "muted"

    },
    "clock": {
        "format": "{:%H:%M:%S}  ",
        "interval": 1,
        "tooltip-format": "<span>{calendar}</span>",
        "calendar": {
                "mode": "month",
                "format": {
                    "months": "<span color='#ff6699'><b>{}</b></span>",
                    "days": "<span color='#cdd6f4'><b>{}</b></span>",
                    "weekdays": "<span color='#7CD37C'><b>{}</b></span>",
                    "today": "<span color='#ffcc66'><b>{}</b></span>"
            }
        },
        "actions": {
                "on-click-right": "mode",
                "on-scroll-up": "tz-up",
                "on-scroll-down": "tz-down",
                "on-scroll-up": "shift_up",
                "on-scroll-down": "shift_down",
                "on-click-middle": "reset"
        }
    },
    "tray": {
        "size": 21,
        "spacing": 2,
        "reverse-direction": "false"
    },
    "custom/cava": {
        "exec": "~/.config/scripts/cava-remaster.sh",
        "on-click": "notify-send 'Cava is running!'"
    },
    "custom/lofi": {
        "format": "{icon}",
        "format-icons": [
            "☕️"
        ],
        "on-click": "~/.config/scripts/lofi.sh"
    },
    "cpu": {
        "interval": 10,
        "format": "{usage}%  ",
        "max-length": 10,
        "tooltip": true
    },
    "battery": {
        "format": "{capacity}%",
        "format-icons": [" ", " ", " ", " ", " "]
    },
    "network": {
        "interface": "wlan0",
        "format-icons": " ",
        "format": "{icon}",
        "format-wifi": "{icon}",
        "format-disconnected": "oops :(",
        "on-click": "nm-connection-editor",
        "tooltip-format": "{ifname} via {gwaddr} 󰊗 ",
        "tooltip-format-wifi": "{essid}, ({signalStrength}%)  ",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 14,
        "icon-theme": "Numix-Circle",
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "ignore-list": [
           "Alacritty",
           "kitty",
           "thunar"
        ]
    },
    "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": " <span foreground='red'><sup></sup></span>",
      "none": " ",
      "dnd-notification": "< span foreground='red'><sup></sup></span>",
      "dnd-none": " ",
      "inhibited-notification": " <span foreground='red'><sup></sup></span>",
      "inhibited-none": " ",
      "dnd-inhibited-notification": "< span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": " "
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "custom/power": {
    "on-click": "wlogout",
    "format": "<span color=\"#f38ba8\"> </span>"

  }
}
